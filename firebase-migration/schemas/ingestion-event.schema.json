{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wmgj.example/schemas/ingestion-event.schema.json",
  "title": "WMGJ Firestore Ingestion Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventId", "eventType", "orgId", "occurredAt",
    "idempotencyKey", "entityType", "entityKey", "expectedVersion", "actor", "source",
    "workflowState", "reviewState", "riskLevel", "sensitivity", "record"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "eventType": { "enum": ["ENTITY_UPSERT", "DOCUMENT_UPSERT", "RUNTIME_CHECKPOINT", "AI_RUN_RECORDED"] },
    "orgId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 512 },
    "entityType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,63}$" },
    "entityKey": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expectedVersion": { "type": "integer", "minimum": 0 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "source"],
      "properties": {
        "type": { "enum": ["SYSTEM", "USER", "AI"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "sourceId"],
      "properties": {
        "system": { "enum": ["GMAIL", "DRIVE", "SHEETS", "APPS_SCRIPT", "MANUAL"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sourceVersion": { "type": "string", "maxLength": 128 },
        "parentId": { "type": "string", "maxLength": 512 },
        "fileName": { "type": "string", "maxLength": 512 },
        "mimeType": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 2048 },
        "contentHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "hashMethod": { "enum": ["content_sha256", "metadata_sha256_fallback", "row_sha256"] }
      }
    },
    "workflowState": { "enum": ["RECEIVED", "QUEUED", "CLASSIFIED", "EXTRACTED", "NORMALIZED", "PENDING_EVIDENCE", "PENDING_HUMAN_REVIEW", "BLOCKED", "VALIDATED", "CLOSED", "CANCELLED", "FAILED", "DEAD_LETTER"] },
    "reviewState": { "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED", "CHANGES_REQUESTED", "EXPIRED"] },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "RESTRICTED", "CLINICAL_SENSITIVE"] },
    "competence": { "type": "string", "pattern": "^$|^\\d{4}-(0[1-9]|1[0-2])$" },
    "documentType": { "type": "string", "maxLength": 128 },
    "record": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "orgId", "schemaVersion", "entityType", "entityKey", "version", "competence",
            "documentType", "workflowState", "reviewState", "riskLevel", "sensitivity", "source",
            "metadata", "migration", "createdAt", "updatedAt"
          ]
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
