{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wmgj.example/schemas/hkgk/governance-analysis-input-v1.json",
  "title": "Governance Analysis Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orgId", "taskType", "sensitivity", "evidenceRefs", "inputHash", "redactedInput",
    "promptVersion", "ruleSetVersion", "inputSchemaVersion", "outputSchemaVersion"
  ],
  "properties": {
    "orgId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" },
    "taskType": { "enum": ["DOCUMENT_REVIEW", "GOVERNANCE_FINDINGS", "CONTROL_GAP_REVIEW"] },
    "sensitivity": { "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"] },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^(synthetic|drive|firestore|source)://sha256/[a-f0-9]{64}$"
      }
    },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "redactedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competence", "variance", "synthetic"],
      "properties": {
        "competence": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "variance": { "type": ["integer", "number"] },
        "synthetic": { "type": "boolean", "const": true },
        "billedAmount": { "type": ["integer", "number", "null"] },
        "authorizedAmount": { "type": ["integer", "number", "null"] },
        "documentCount": { "type": ["integer", "null"], "minimum": 0 },
        "exceptionCount": { "type": ["integer", "null"], "minimum": 0 },
        "requiresAuthorization": { "type": ["boolean", "null"] },
        "opme": { "type": ["boolean", "null"] },
        "reconciliationState": {
          "type": ["string", "null"],
          "enum": ["MATCHED", "PENDING", "DIVERGENT", "NOT_APPLICABLE", null]
        }
      }
    },
    "promptVersion": { "type": "string", "const": "governance-v1" },
    "ruleSetVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "inputSchemaVersion": { "type": "integer", "const": 1 },
    "outputSchemaVersion": { "type": "integer", "const": 1 }
  }
}
